<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>{{title}} | Travlr Getaways</title>
  <link rel="stylesheet" href="/css/style.css" type="text/css" />
</head>

<body>
  <div id="background">
    <div id="page">
      <div id="header">
        <div id="logo">
          <a href="/"><img src="/images/logo.png" alt="Travlr Getaways" /></a>
        </div>

        <div id="navigation">
          <ul>
            <li class="selected"><a href="/">HOME</a></li>
            <li><a href="/travel">TRAVEL</a></li>
            <li><a href="/rooms">ROOMS</a></li>
            <li><a href="/meals">MEALS</a></li>
            <li><a href="/news">NEWS</a></li>
            <li><a href="/about">ABOUT</a></li>
            <li><a href="/contact">CONTACT</a></li>
          </ul>
        </div>
      </div>

      <div id="contents">
        <div class="box">
          <div>
            <div class="body">
              <h1>Enjoy the Summer With Us!</h1>

              <div id="adbox">
                <img src="/images/sea-sound.jpg" alt="The Sound of the Sea" />
                <h2>THE SOUND OF THE SEA</h2>
              </div>

              <p>
                Welcome to Travlr Getaways! This site is now running using Node, Express, and Handlebars (MVC).
                Use the navigation above to explore the pages.
              </p>

              <div class="news">
                <h2>Latest Blog</h2>
                <ul>
                  <li>
                    <h3>2023 Best Beaches Contest Winners</h3>
                    <span>April 02, 2023</span>
                    <p>Explore the world’s most beautiful shorelines, from tropical escapes to hidden coastal gems.</p>
                  </li>
                  <li>
                    <h3>Top 10 Diving Spots</h3>
                    <span>May 29, 2023</span>
                    <p>Discover breathtaking reefs, shipwrecks, and crystal-clear waters perfect for adventure.</p>
                  </li>
                </ul>
              </div>

              <div class="featured">
                <h2>Featured</h2>
                <ul>
                  <li>
                    <a href="/rooms"><img src="/images/rooms.jpg" alt="Rooms" /></a>
                    <h3>Rooms</h3>
                    <p>Comfortable stays designed for relaxation.</p>
                  </li>
                  <li>
                    <a href="/travel"><img src="/images/dive-site.jpg" alt="Travel" /></a>
                    <h3>Travel</h3>
                    <p>Plan unforgettable trips with ease.</p>
                  </li>
                  <li>
                    <a href="/meals"><img src="/images/food.jpg" alt="Meals" /></a>
                    <h3>Food</h3>
                    <p>Enjoy local flavors and delicious dining.</p>
                  </li>
                </ul>
              </div>

            </div>
          </div>
        </div>
      </div>

      <div id="footer">
        <div>
          <p>&copy; {{year}} Travlr Getaways. All rights reserved.</p>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
