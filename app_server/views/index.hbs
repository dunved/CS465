<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>{{title}} | Travlr Getaways</title>
  <link rel="stylesheet" href="/css/style.css" type="text/css" />
</head>
<body>
  <div id="background">
    <div id="page">
      <div id="header">
        <div id="logo">
          <a href="/"><img src="/images/logo.png" alt="Travlr Getaways" /></a>
        </div>

        <div id="navigation">
          <ul>
            <li class="selected"><a href="/">Home</a></li>
            <li><a href="/travel">Travel</a></li>
            <li><a href="/rooms">Rooms</a></li>
            <li><a href="/meals">Meals</a></li>
            <li><a href="/news">News</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
      </div>

      <div id="contents">
        <div class="box">
          <div>
            <div class="body">
              <h1>Enjoy the Summer With Us!</h1>

              <div id="adbox">
                <img src="/images/sea-sound.jpg" alt="The Sound of the Sea" />
                <h1>The Sound of the Sea</h1>
              </div>

              <p>
                Welcome to Travlr Getaways! This site is now running using Node, Express, and Handlebars (MVC).
                Use the navigation above to explore the pages.
              </p>

              <h2>Latest Blog</h2>
              <ul>
                <li>
                  <strong>2023 Best Beaches Contest Winners</strong><br />
                  <small>April 02, 2023</small><br />
                  Explore the world’s most beautiful shorelines, from tropical escapes to hidden coastal gems.
                </li>
                <li>
                  <strong>Top 10 Diving Spots</strong><br />
                  <small>May 29, 2023</small><br />
                  Discover breathtaking reefs, shipwrecks, and crystal-clear waters perfect for adventure.
                </li>
              </ul>

              <h2>Featured</h2>
              <p>
                Plan your next getaway with our curated travel destinations, room options, meals, and news.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div id="footer">
        <div>
          <p>&copy; {{year}} Travlr Getaways</p>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
