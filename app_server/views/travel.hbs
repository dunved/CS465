<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>{{title}} | Travlr Getaways</title>
  <link rel="stylesheet" href="/css/style.css" type="text/css" />
</head>
<body>
  <div id="background">
    <div id="page">
      <div id="header">
        <div id="logo">
          <a href="/"><img src="/images/logo.png" alt="Travlr Getaways" /></a>
        </div>

        <div id="navigation">
          <ul>
            <li><a href="/">Home</a></li>
            <li class="selected"><a href="/travel">Travel</a></li>
            <li><a href="/rooms">Rooms</a></li>
            <li><a href="/meals">Meals</a></li>
            <li><a href="/news">News</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
      </div>

      <div id="contents">
        <div class="box">
          <div>
            <div class="body">
              <h1>TRAVEL</h1>

              {{#if trips.length}}
                {{#each trips}}
                  <div class="section">
                    <h2>{{name}}</h2>
                    <p>{{description}}</p>
                    <p><strong>Length:</strong> {{length}}</p>
                    <p><strong>Price:</strong> ${{price}}</p>
                  </div>
                {{/each}}
              {{else}}
                <p>No trips are available right now. Please check back later.</p>
              {{/if}}

            </div>
          </div>
        </div>
      </div>

      <div id="footer">
        <div>
          <p>&copy; {{year}} Travlr Getaways</p>
        </div>
      </div>

    </div>
  </div>
</body>
</html>
