<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>{{title}} | Travlr Getaways</title>
  <link rel="stylesheet" href="/css/style.css" type="text/css" />
</head>

<body>
  <div id="background">
    <div id="page">
      <div id="header">
        <div id="logo">
          <a href="/"><img src="/images/logo.png" alt="Travlr Getaways" /></a>
        </div>

        <div id="navigation">
          <ul>
            <li><a href="/">HOME</a></li>
            <li><a href="/travel">TRAVEL</a></li>
            <li><a href="/rooms">ROOMS</a></li>
            <li><a href="/meals">MEALS</a></li>
            <li><a href="/news">NEWS</a></li>
            <li><a href="/about">ABOUT</a></li>
            <li class="selected"><a href="/contact">CONTACT</a></li>
          </ul>
        </div>
      </div>

      <div id="contents">
        <div class="box">
          <div>
            <div class="body">
              <h1>Contact</h1>

              <div class="article">
                <h2>Get in Touch</h2>
                <p>Have questions about planning a trip? Send us a message below.</p>

                <form action="#" method="post">
                  <p><label>Name<br><input type="text" name="name"></label></p>
                  <p><label>Email<br><input type="text" name="email"></label></p>
                  <p><label>Message<br><textarea name="message" cols="30" rows="8"></textarea></label></p>
                  <p><input type="submit" value="Send"></p>
                </form>
              </div>

            </div>
          </div>
        </div>
      </div>

      <div id="footer">
        <div>
          <p>&copy; {{year}} Travlr Getaways. All rights reserved.</p>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
