<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>{{title}} | Travlr Getaways</title>
  <link rel="stylesheet" href="/css/style.css" type="text/css" />
</head>
<body>
  <div id="background">
    <div id="page">
      <div id="header">
        <div id="logo">
          <a href="/"><img src="/images/logo.png" alt="Travlr Getaways" /></a>
        </div>

        <div id="navigation">
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/travel">Travel</a></li>
            <li><a href="/rooms">Rooms</a></li>
            <li><a href="/meals">Meals</a></li>
            <li class="selected"><a href="/news">News</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
      </div>

      <div id="contents">
        <div class="box">
          <div>
            <div class="body">
              <h1>News</h1>

              <h2>New Summer Packages Released</h2>
              <p>We’ve added new destinations and upgraded bundles for this season.</p>

              <h2>Dining Menu Refresh</h2>
              <p>Try our newly updated menu featuring fresh, local ingredients.</p>

              <h2>Travel Tips & Updates</h2>
              <p>Check back weekly for updated travel guides and resort announcements.</p>
            </div>
          </div>
        </div>
      </div>

      <div id="footer">
        <div>
          <p>&copy; {{year}} Travlr Getaways</p>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
