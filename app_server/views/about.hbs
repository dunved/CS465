<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>{{title}} | Travlr Getaways</title>
  <link rel="stylesheet" href="/css/style.css" type="text/css" />
</head>
<body>
  <div id="background">
    <div id="page">
      <div id="header">
        <div id="logo">
          <a href="/"><img src="/images/logo.png" alt="Travlr Getaways" /></a>
        </div>

        <div id="navigation">
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/travel">Travel</a></li>
            <li><a href="/rooms">Rooms</a></li>
            <li><a href="/meals">Meals</a></li>
            <li><a href="/news">News</a></li>
            <li class="selected"><a href="/about">About</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
      </div>

      <div id="contents">
        <div class="box">
          <div>
            <div class="body">
              <h1>About</h1>
              <p>
                Travlr Getaways is a demo travel site built for CS465 using an MVC architecture.
                The project uses Node.js, Express routing/controllers, and Handlebars templates for views.
              </p>
              <p>
                This site demonstrates converting static HTML into dynamic templates while keeping the
                original design intact.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div id="footer">
        <div>
          <p>&copy; {{year}} Travlr Getaways</p>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
